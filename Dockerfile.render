FROM node:22-slim AS frontend
WORKDIR /build
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY web/app ./app
COPY web/next.config.mjs ./
ENV STATIC_EXPORT=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY api.py service.py extraction.py models.py rules.py ./
COPY data/vendors.csv data/purchase_orders.csv data/purchase_order_lines.csv ./data/
COPY --from=frontend /build/out ./web/out
ENV LOCAL_SETUP=0
ENV COOKIE_SECURE=1
ENV PORT=10000
EXPOSE 10000
CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
